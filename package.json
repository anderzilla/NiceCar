{
  "name": "nicecar",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "verify": "bash scripts/verify.sh",
    "verify:full": "bash scripts/verify.sh --full",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:seed": "pnpm --filter backend exec prisma db seed",
    "demo:reset": "pnpm --filter backend run demo:reset"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "prettier": "^3.3.3"
  }
}
